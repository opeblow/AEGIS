# ============================================================
# Aegis Frontend — Environment Configuration
# Copy this file to .env.local and fill in real values.
# Only NEXT_PUBLIC_* values reach the browser bundle. Everything
# else stays server-side. Never put a secret behind NEXT_PUBLIC_.
# ============================================================

# Base origin of the Aegis backend (no trailing /api/v1 — it is appended
# in src/lib/api.ts). Development default is http://127.0.0.1:4000.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:4000

# Base URL of the Metatarz EVM JSON-RPC shim used for Canton reads from
# the browser (eth_getBalance / eth_call / eth_getTransactionReceipt).
# Default: https://canton-testnet.rpc.wallet.metatarz.xyz
# Must match the backend's METATARZ_RPC_URL.
NEXT_PUBLIC_METATARZ_RPC_URL=https://canton-testnet.rpc.wallet.metatarz.xyz

# ------------------------------------------------------------
# Demo mode — DO NOT ENABLE for real use.
# ------------------------------------------------------------
# Substitutes offline stand-ins for OneSwap quotes/swaps, Canton ledger
# confirmation, and the Metatarz wallet extension so the whole flow can be
# demonstrated on a machine with no wallet and no integrator account. Results
# are fabricated and a persistent banner marks the UI as a demo.
# Inlined at build time — set before `npm run build`, then rebuild.
NEXT_PUBLIC_DEMO_MODE=false

# ------------------------------------------------------------
# Production notes
# ------------------------------------------------------------
# 1. NEXT_PUBLIC_* values are inlined at BUILD time, not read at runtime.
#    Set them in the host's environment before `npm run build`, then rebuild
#    when a value changes.
# 2. NEXT_PUBLIC_API_BASE must be the public HTTPS origin of the backend, and
#    that origin must also appear in the backend's CORS_ORIGIN list.
# 3. Session auth uses HttpOnly cookies from the backend. The frontend and the
#    API must share a site (or be configured for cross-site cookies), otherwise
#    the session cookie is dropped by the browser.
# 4. The backend sets cookies with the Secure flag in production, so serve both
#    the frontend and the API over HTTPS.
