# ============================================================
# Aegis Backend — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================================

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP server binding
PORT=4000
HOST=0.0.0.0

# PostgreSQL connection string (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis?schema=public

# Comma-separated list of allowed CORS origins
# Use * to allow any origin (development only)
# Production rejects '*' and requires explicit origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Minimum log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ------------------------------------------------------------
# Authentication (Phase 2)
# ------------------------------------------------------------

# Absolute session lifetime before forced re-authentication (milliseconds).
# Default: 7 days (604800000)
AUTH_SESSION_TTL_MS=604800000

# Idle timeout — reject sessions unused for this long (milliseconds).
# Default: 30 minutes (1800000)
AUTH_SESSION_IDLE_MS=1800000

# Email verification token validity (milliseconds). Default: 24 hours.
AUTH_VERIFICATION_TOKEN_TTL_MS=86400000

# Password reset token validity (milliseconds). Default: 60 minutes.
AUTH_PASSWORD_RESET_TOKEN_TTL_MS=3600000

# Per-account failed-login attempts before temporary throttling. Default: 5.
AUTH_LOGIN_MAX_ATTEMPTS=5

# Temporary throttle window after failed attempts (milliseconds). Default: 15 min.
AUTH_LOGIN_THROTTLE_MS=900000

# Optional Argon2id password pepper (server-side secret, max 32 bytes).
# Keep OUT of PostgreSQL — this is the app-and-secret-management only.
# Leave blank to rely on per-password Argon2id salts + strong secret management.
PASSWORD_PEPPER=

# Minimum / maximum accepted password length.
# Length-first policy: strong minimum, allow long passphrases, never truncate,
# cap input size to prevent abuse.
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=1024

# Force Secure cookies outside production (use only when the API is served
# over HTTPS but NODE_ENV is not production, e.g. staging behind TLS).
# Leave blank to derive from NODE_ENV (production -> Secure).
AUTH_COOKIE_SECURE=

# ------------------------------------------------------------
# Organizations (Phase 3)
# ------------------------------------------------------------

# Organization invitation token validity (milliseconds). Default: 72 hours.
ORG_INVITATION_TTL_MS=259200000

# ------------------------------------------------------------
# Documents & requirements (Phase 6)
# ------------------------------------------------------------

# Storage backend for uploaded document bytes. Only the dev-friendly
# local-disk adapter ships in Phase 6. Production adapters (S3 etc.) will
# arrive with the same DocumentStorage interface.
# Default: local-disk
# DOCUMENT_STORAGE_PROVIDER=local-disk

# Filesystem root for the local-disk adapter.
# Default: <cwd>/.document-storage  (git-ignored)
# DOCUMENT_STORAGE_ROOT=C:\dev\aegis\.document-storage

# Hard cap on a single uploaded document (bytes). Default: 25 MB (26214400).
# DOCUMENT_MAX_SIZE_BYTES=26214400

# Window in which an UPLOADING/UPLOADED document must be completed and
# submitted before the worker expires it (milliseconds). Default: 2 hours.
# DOCUMENT_UPLOAD_WINDOW_MS=7200000

# Review window for SUBMITTED -> (ACCEPTED|REJECTED), and the retention window
# of an ACCEPTED document (milliseconds). Default: 72 hours.
# DOCUMENT_REVIEW_WINDOW_MS=259200000

# ------------------------------------------------------------
# Settlement & Reconciliation (Phase 8)
# ------------------------------------------------------------

# Settlement provider. mock (default) | canton (not yet implemented).
# SETTLEMENT_PROVIDER=mock

# ------------------------------------------------------------
# Deal Intelligence (Phase 9)
# ------------------------------------------------------------

# Base URL of the internal AI/ML service (`ai-ml/`). Required — the backend
# refuses to boot without it.
AI_SERVICE_URL=http://127.0.0.1:8555

# Shared service-to-service bearer token. Leave blank in development (ai-ml
# serves unauthenticated when it has no token). REQUIRED in production.
AI_SERVICE_TOKEN=

# Per-call timeout for the AI/ML service (ms). Default: 15000.
AI_SERVICE_TIMEOUT_MS=15000

# ------------------------------------------------------------
# Quantum Optimization (Phase 10)
# ------------------------------------------------------------

# Base URL of the internal quantum optimization service ("quantum computing/").
# Required — the backend refuses to boot without it.
QUANTUM_SERVICE_URL=http://127.0.0.1:8557

# Shared service-to-service bearer token. The quantum service's own
# `QUANTUM_API_TOKEN` (default: dev-token). Leave blank in development when
# the service is unauthenticated. REQUIRED in production.
QUANTUM_SERVICE_TOKEN=dev-token

# Per-call timeout for the quantum service (ms). Defaults above the service's
# own 30s solver timeout so the backend outlasts a long-running solve.
# Default: 35000.
QUANTUM_SERVICE_TIMEOUT_MS=35000