# Aegis deployment environment.
# Copy to .env at the repo root for `docker compose up`. NEVER commit a filled
# copy — the values below are placeholders, and the two service tokens must be
# regenerated per environment.
#
# Generate a fresh token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Shared secrets (must be identical on both sides of each pair) ---------
AI_SERVICE_TOKEN=replace-me-with-a-random-32-byte-token
QUANTUM_SERVICE_TOKEN=replace-me-with-a-different-random-32-byte-token

# --- Frontend (inlined at build time by Next.js) --------------------------
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_METATARZ_RPC_URL=https://canton-testnet.rpc.wallet.metatarz.xyz
NEXT_PUBLIC_DEMO_MODE=true

# --- Demo data ------------------------------------------------------------
DEMO_SEED_PASSWORD=AegisDemo!2026