# Aegis Deal Intelligence — service configuration.
# Copy to .env and adjust. Never commit real credentials.

# --- App ---
AEGIS_AI_PORT=8555
AEGIS_AI_ENVIRONMENT=development
AEGIS_AI_LOG_LEVEL=info
AEGIS_AI_ANALYSIS_VERSION=1

# --- Service-to-service credential (required in production) ---
# Shared secret the backend sends as `Authorization: Bearer <token>`.
# When empty, the /analyze and /query endpoints are NOT protected, which is
# only acceptable for local development.
AEGIS_AI_SERVICE_TOKEN=dev-super-secret-token

# --- Model provider ---
# Canonical values: mock | hosted
# mock = deterministic, no credentials, fully reproducible (default)
# hosted = external model; REQUIRES DEPLOYED_MODEL_URL and DEPLOYED_MODEL_API_KEY
AEGIS_AI_MODEL_PROVIDER=mock
AEGIS_AI_MODEL_VERSION=aegis-mock-v1

# --- Request guards ---
AEGIS_AI_MAX_CONTEXT_BYTES=1500000
AEGIS_AI_MAX_QUERY_BYTES=4096